#!/bin/bash
# 升级后：① 刷新 root 固化副本（脚本 + deploy/） ② 用新代码启动网关
#
# 为什么必须在钩子里刷新：
#   fnOS 的 install-fpk 不覆盖已存在的文件，而 sudoers 唯一放行的那份脚本是
#   /usr/local/lib/oesp-gpu/oesp_gpu_fix.sh（一键授权固化过去的副本）。不刷新它，
#   用户升级到新版后「面板是新的、真正动手的还是旧脚本」——
#   v1.3.5/1.3.6 用户升级后仍报「包内 deploy/ 也未找到」就是这么来的：
#   旧副本只在自己同级找 deploy/，而旧版授权只固化了脚本本体。
set -u
APP_DEST="${TRIM_APPDEST:-/var/apps/gpuconsole/target}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/gpuconsole/var}"
SEC_DIR=/usr/local/lib/oesp-gpu
log(){ mkdir -p "$VAR_DIR" 2>/dev/null; echo "[$(date '+%F %T')] upgrade_callback: $*" >> "$VAR_DIR/cmd.log" 2>/dev/null; }

sync_secure() {
    local src="$APP_DEST/scripts/oesp_gpu_fix.sh"
    if [ ! -f "$src" ]; then log "包内脚本缺失，跳过刷新"; return 0; fi
    # 只在「用户已经授权过」时动 root 目录，避免替未授权的用户凭空造文件
    if [ ! -f /etc/sudoers.d/gpuconsole-fix ] && [ ! -f "$SEC_DIR/oesp_gpu_fix.sh" ]; then
        log "尚未授权，跳过刷新（等用户点一键授权）"; return 0
    fi
    mkdir -p "$SEC_DIR/deploy" 2>/dev/null
    if cmp -s "$src" "$SEC_DIR/oesp_gpu_fix.sh"; then
        log "固化脚本已是最新"
    else
        cp -f "$src" "$SEC_DIR/oesp_gpu_fix.sh" 2>/dev/null \
            && chmod 755 "$SEC_DIR/oesp_gpu_fix.sh" \
            && log "固化脚本已刷新 → $(stat -c%s "$src" 2>/dev/null) B"
    fi
    # deploy/：脚本与源码一律覆盖；.ko 只在【缺失】时补 —— 设备上可能已按当前
    # 内核现场重编过一份，用包内预编译版覆盖反而造成 vermagic 不符。
    local d="$APP_DEST/scripts/deploy" f b sd sb n=0
    if [ -d "$d" ]; then
        for f in "$d"/*; do
            [ -f "$f" ] || continue
            b=$(basename "$f")
            case "$b" in
                *.ko) [ -f "$SEC_DIR/deploy/$b" ] || cp -f "$f" "$SEC_DIR/deploy/$b" 2>/dev/null ;;
                *)    cp -f "$f" "$SEC_DIR/deploy/$b" 2>/dev/null ;;
            esac
            n=$((n + 1))
        done
        # v1.3.10：deploy/<内核版本>/ 子目录（按 vermagic 分发的预编译物）也要同步，
        # 否则新脚本优先找的版本目录在固化副本旁是空的，又退回平铺位。
        for sd in "$d"/*/; do
            [ -d "$sd" ] || continue
            sb=$(basename "$sd")
            mkdir -p "$SEC_DIR/deploy/$sb" 2>/dev/null
            for f in "$sd"*; do
                [ -f "$f" ] || continue
                b=$(basename "$f")
                case "$b" in
                    *.ko) [ -f "$SEC_DIR/deploy/$sb/$b" ] || cp -f "$f" "$SEC_DIR/deploy/$sb/$b" 2>/dev/null ;;
                    *)    cp -f "$f" "$SEC_DIR/deploy/$sb/$b" 2>/dev/null ;;
                esac
                n=$((n + 1))
            done
            log "deploy/$sb 已同步"
        done
        log "deploy/ 已同步（包内 $n 个文件，目标目录 $(ls -1 "$SEC_DIR/deploy" 2>/dev/null | wc -l) 个）"
    else
        log "包内 deploy/ 缺失（异常，请检查安装包）"
    fi
    chown -R 0:0 "$SEC_DIR" 2>/dev/null
    sync
}
if [ "$(id -u)" = "0" ]; then sync_secure; fi

# ---- 启动网关 ----
# 解释器探测（fnOS 应用环境 PATH 可能不全，必须绝对路径兜底）
PY=$(command -v python3 2>/dev/null)
[ -z "$PY" ] && PY=$(command -v python 2>/dev/null)
[ -z "$PY" ] && [ -x /usr/bin/python3 ] && PY=/usr/bin/python3
[ -z "$PY" ] && PY=python3
"$PY" "$APP_DEST/server/gateway.py" start 2>&1 | tee -a "$VAR_DIR/cmd.log"
exit 0
